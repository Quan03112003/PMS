# Sao chép thành .env để Docker Compose dùng. Đổi mật khẩu khi triển khai thực tế.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# PMS gọi AIservice (Python) khi có địa chỉ. Để trống thì API tự ghép câu trả lời từ số liệu.
AI__Provider=local
AI__ServiceUrl=http://127.0.0.1:8090
AI__ServiceKey=local-dev-only
AI__ModelPath=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
AI__EmbeddingModel=
AI__MaxTokens=160
AI__Temperature=0.1
AI__ChunkChars=800
AI__ChunkOverlap=120
